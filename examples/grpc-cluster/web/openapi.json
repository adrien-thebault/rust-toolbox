          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limited; see Retry-After"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "An internal failure. The body carries a code and a request id, never a detail"
          }
        },
        "summary": "`GET`: one todo.",
        "tags": [
          "todo"
        ]
      }
    }
  }
}
