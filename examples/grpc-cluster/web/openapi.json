{
  "components": {
    "schemas": {
      "NewTodo": {
        "description": "A new todo.",
        "properties": {
          "title": {
            "description": "What to do.",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "TodoDto": {
        "description": "A todo as the HTTP API presents it.\n\nA hand-written DTO rather than the proto type: proto3 enums become `i32`,\nso a generated schema documents them as integers.",
        "properties": {
          "done": {
            "description": "Whether it is done.",
            "type": "boolean"
          },
          "id": {
            "description": "Its id.",
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "What to do.",
            "type": "string"
          },
          "version": {
            "description": "For optimistic locking on completion.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "done",
          "version"
        ],
        "type": "object"
      },
      "TodoPage": {
        "description": "One page of todos.",
        "properties": {
          "items": {
            "description": "The rows.",
            "items": {
              "$ref": "#/components/schemas/TodoDto"
            },
            "type": "array"
          },
          "total": {
            "description": "How many matched in total.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Adrien Thébault"
    },
    "description": "The example's HTTP gateway: it owns authentication and calls the backend.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Todo API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/todos": {
      "get": {
        "description": "# Arguments\n\n* `state` - The gateway's state, for the backend channel.\n* `page` - The window and sort, already validated against the maximum limit.",
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoPage"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request was malformed or failed validation"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No credentials, or credentials that did not verify"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Authenticated, but not permitted"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No such resource"
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request conflicts with current state"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limited; see Retry-After"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "An internal failure. The body carries a code and a request id, never a detail"
          }
        },
        "summary": "`GET`: one page of todos.",
        "tags": [
          "todo"
        ]
      },
      "post": {
        "description": "# Arguments\n\n* `state` - The gateway's state, for the backend channel.\n* `body` - The new todo, rejected here if invalid so no hop is made.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTodo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request was malformed or failed validation"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No credentials, or credentials that did not verify"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Authenticated, but not permitted"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No such resource"
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request conflicts with current state"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limited; see Retry-After"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "An internal failure. The body carries a code and a request id, never a detail"
          }
        },
        "summary": "`POST`: add a todo.",
        "tags": [
          "todo"
        ]
      }
    },
    "/api/todos/{id}": {
      "delete": {
        "description": "# Arguments\n\n* `_` - The extractor that enforces the role. An anonymous caller is a 401\n  and never reaches the backend.\n* `state` - The gateway's state, for the backend channel.\n* `id` - Which todo.",
        "operationId": "remove",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request was malformed or failed validation"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No credentials, or credentials that did not verify"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Authenticated, but not permitted"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "No such resource"
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "The request conflicts with current state"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limited; see Retry-After"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "An internal failure. The body carries a code and a request id, never a detail"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "`DELETE`: soft-delete a todo. Needs the admin role, and the type system\nchecks it.",
        "tags": [
          "todo"
        ]
      },
      "get": {
        "description": "# Arguments\n\n* `state` - The gateway's state, for the backend channel.\n* `id` - Which todo. A miss is the backend's `TODO_NOT_FOUND`, relayed with\n  its code intact.",
        "operationId": "fetch",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {}
