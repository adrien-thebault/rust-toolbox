# Committed, working values for this example - it is a public demo with no
# real secret at stake, so `docker compose up` runs with no setup step. Start
# from `.env.example` instead for a project of your own, where none of that
# holds.
#
# compose.yaml reads this file, and so does each service's `main` -
# `AuthConfig::from_env` is what turns the last three into a working login.

# Where each process listens. The backend speaks gRPC, the gateway HTTP.
LISTEN_ADDR=0.0.0.0:8080

# Where the gateway looks for the backend. compose.yaml overrides this with the
# service name; the default is for `cargo run` on the host.
TODO_BACKEND=http://127.0.0.1:50051

# What the gateway presents to the backend on every call, and the backend
# checks before TodoService sees the request at all. Generate one with
# `openssl rand -hex 32`; the value only has to match between the two.
SERVICE_SECRET=0123456789abcdef0123456789abcdef

# How many proxies append to `X-Forwarded-For` before a request arrives. Set it
# too low behind one and the login limiter keys on the proxy's own address, so
# the first attacker locks out every other caller.
TRUSTED_HOPS=1

# The database the backend owns. SQLite here, so it is a path, not a URL.
DATABASE_URL=/data/todos.sqlite3

# `json` for a log collector, `pretty` for a terminal.
LOG_FORMAT=pretty
RUST_LOG=info

# At least 32 bytes: HS256 rejects a shorter key rather than weakening itself.
# Generate one with `openssl rand -hex 32`.
SESSION_SECRET=0123456789abcdef0123456789abcdef

# The one seeded account: admin / admin. Produced with
# ./scripts/hash-password.sh; keep the single quotes, or the `$` separators in
# a PHC string get read as variable references.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$2Srkixf7i+/fgXvn6j9nww$sZ2TNoC1HDJhTZQeia3/hX/zufcg06zi0VXT6i2HUMs'
