# Copy to .env before `docker compose up`. compose.yaml reads it.

# Where each process listens. The service speaks gRPC, the gateway HTTP.
LISTEN_ADDR=0.0.0.0:8080

{% if database == "postgres" %}# The database the service owns.
DATABASE_URL=postgres://app:app@db:5432/app
{% else %}# The database the service owns. SQLite, so a path rather than a URL.
DATABASE_URL=/data/app.sqlite3
{% endif %}
# `single` refuses to start with an in-process adapter under `clustered`, which
# is what stops a three-replica deploy silently keeping three separate caches.
DEPLOYMENT=single

# `json` for a log collector, `pretty` for a terminal.
LOG_FORMAT=json
RUST_LOG=info
{% if gateway %}
# Where the gateway looks for the service.
SERVICE_BACKEND=http://{{project-name}}:50051

# How many proxies append to `X-Forwarded-For` before a request arrives. Set it
# too low behind one and the login limiter keys on the proxy's own address, so
# the first attacker locks out every other caller.
TRUSTED_HOPS=1

# At least 32 bytes: HS256 rejects a shorter key rather than weakening itself.
# Generate one with `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-at-least-32-bytes-long

# The one seeded account. Produce the hash with
# `cargo run -p toolbox-auth --features password --example hash-password`, and
# keep the single quotes: the `$` separators in a PHC string would otherwise be
# read as variable references.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHR2YWx1ZQ$replace-me'
{% endif %}
